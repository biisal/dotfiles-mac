// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
	{
		"context": "Workspace || VimControl",
		"bindings": {
			"ctrl-h": "workspace::ActivatePaneLeft",
			"ctrl-l": "workspace::ActivatePaneRight",
		},
	},
	{
		"context": "Editor && vim_mode == visual",
		"bindings": {
			"=": "editor::FormatSelections",
		},
	},
	{
		"context": "Workspace && !(vim_mode == insert) && !Terminal",
		"bindings": {
			"space f f": "file_finder::Toggle",
		},
	},
	{
		"context": "Editor || ProjectPanel",
		"bindings": {
			"ctrl-o": "project_panel::ToggleFocus",
		},
	},
	{
		"context": "Editor && VimControl && vim_mode == normal",
		"bindings": {
			"space d d": "diagnostics::Deploy",
		},
	},
	{
		"context": "Editor && vim_mode == normal",
		"bindings": {
			"ctrl-c": ["workspace::SendKeystrokes", ": % y enter"],
		},
	},
	{
		"context": "Editor && (vim_mode == visual || vim_mode == visual_line || vim_mode == visual_block)",
		"bindings": {
			"p": ["workspace::SendKeystrokes", "P"],
		},
	},
]
