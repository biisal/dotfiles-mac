{
 "disable_ai": true,
 "language_models": {
		"openai_compatible": {
			"code-open": {
				"api_url": "https://opencode.ai/zen/v1",
				"available_models": [
					{
						"name": "deepseek-v4-flash-free",
						"max_tokens": 1048576,
						"max_output_tokens": 384000,
						"max_completion_tokens": 384000,
						"reasoning_effort": "high",
						"capabilities": {
							"tools": true,
							"images": false,
							"parallel_tool_calls": false,
							"prompt_cache_key": true,
							"chat_completions": true,
							"interleaved_reasoning": false,
							"max_tokens_parameter": false
						}
					}
				]
			}
		}
	},
	"experimental.theme_overrides": {
		"editor.document_highlight.read_background": "#ff00ea3c"
	},
	"colorize_brackets": true,
	"diff_view_style": "split",
	"fast_scroll_sensitivity": 1.0,
	"scroll_sensitivity": 4.0,
	"outline_panel": {
		"dock": "left"
	},
	"collaboration_panel": {
		"dock": "left"
	},
	"agent_servers": {},
	"edit_predictions": {
		"open_ai_compatible_api": {
			"model": "deepseek-v4-flash-free",
			"api_url": "https://opencode.ai/zen/v1"
		},
		"codestral": {
			"api_url": "https://codestral.mistral.ai"
		},
		"provider": "zed",
		"mode": "eager"
	},
	"code_actions_on_format": {
		"source.organizeImports.biome": true,
		"source.fixAll.biome": true
	},
	"show_completions_on_input": true,
	"language_servers": ["!eslint", "..."],
	"languages": {
		"TSX": {
			"format_on_save": "on",
			"formatter": "prettier"
		},
		"TypeScript": {
			"format_on_save": "on",
			"formatter": "prettier"
		},
		"JSON": {
			"format_on_save": "on",
			"formatter": "language_server"
		},
		"JavaScript": {
			// "formatter": "language_server",
		},
		"HTML": {
			"formatter": "language_server",
			"format_on_save": "on"
		}
	},
	"git_panel": {
		"dock": "left",
		"tree_view": true
	},
	"lsp": {
		"prisma-language-server": {
			"settings": {
				"prisma": {
					"pinToPrisma6": true
				}
			}
		},
		"gopls": {
			"initialization_options": {
				"gofumpt": true,
				"completeUnimported": true,
				"analyses": {
					"unusedparams": true,
					"useany": true,
					"simplifyrange": true
				},
				"codelenses": {
					"generate": true,
					"test": true,
					"tidy": true
				}
			}
		},
		"golangci-lint": {
			"initialization_options": {
				"command": [
					"golangci-lint",
					"run",
					"--output.json.path",
					"stdout",
					"--show-stats=false",
					"--output.text.path="
				]
			}
		}
	},
	"when_closing_with_no_tabs": "close_window",
	"remove_trailing_whitespace_on_save": false,
	"ensure_final_newline_on_save": false,
	"project_panel": {
		"dock": "left",
		"entry_spacing": "standard"
	},
	"tabs": { "file_icons": true },
	"current_line_highlight": "none",
	"terminal": {
		"dock": "bottom",
		"font_family": "JetBrainsMonoNL Nerd Font",
		"font_weight": 500.0
	},
	"ui_font_family": "Iosevka Nerd Font Mono",
	"ui_font_weight": 600.0,
	"icon_theme": {
		"mode": "light",
		"light": "Material Icon Theme",
		"dark": "Material Icon Theme"
	},
	"agent_buffer_font_size": 14.0,
	"agent_ui_font_size": 17.0,
	"expand_excerpt_lines": 16,
	"agent": {
		"sidebar_side": "left",
		"dock": "right",
		"tool_permissions": {
			"default": "allow"
		},
		"default_profile": "write",
		"default_model": {
			"effort": "high",
			"enable_thinking": true,
			"provider": "code-open",
			"model": "deepseek-v4-flash-free"
		},
		"model_parameters": []
	},
	"hard_tabs": true,
	"buffer_font_family": "Iosevka Nerd Font Mono",
	"buffer_font_weight": 500.0,
	"buffer_line_height": { "custom": 1.4 },
	"vim_mode": true,
	"relative_line_numbers": "enabled",
	"file_types": {
		"html": ["*.html"],
		"python": ["*.py"]
	},
	"base_keymap": "VSCode",
	"ui_font_size": 15.8,
	"buffer_font_size": 17.0,
	"theme": {
		"light": "Ayu Light",
		"mode": "dark",
		"dark": "Ayu Dark"
	},

	"gutter": {
		"min_line_number_digits": 0,
		"line_numbers": true,
		"runnables": false, // Removes the "play" button space (for tests/main)
		"folds": true, // Removes the arrow space for collapsing code
		"breakpoints": false // Removes the red dot space for debugging
	},
	"diagnostics": {
		"inline": {
			"enabled": true
		}
	}
}

