// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	"fast_scroll_sensitivity": 7.0,
	"scroll_sensitivity": 2.0,
	"outline_panel": {
		"dock": "left",
	},
	"collaboration_panel": {
		"dock": "left",
	},
	"agent_servers": {
		"codex-acp": {
			"type": "registry",
		},
		"crush": {
			"type": "custom",
			"command": "/opt/homebrew/bin/codex",
		},

		"opencode": {
			"favorite_models": ["google/gemini-3-pro-preview"],
			"type": "registry",
		},
	},
	"scrollbar": {
		"git_diff": false,
	},
	"sticky_scroll": {
		"enabled": false,
	},
	"edit_predictions": {
		"provider": "zed",
		"mode": "eager",
	},
	"code_actions_on_format": {
		"source.organizeImports.biome": true,
		"source.fixAll.biome": true,
	},
	"show_completions_on_input": true,
	// "auto_signature_help": true,
	// "show_signature_help_after_edits": true,
	"languages": {
		"TSX": {
			"format_on_save": "on",
			"formatter": "prettier",
		},
		"TypeScript": {
			"format_on_save": "on",
			"formatter": "prettier",
		},
		"JSON": {
			"format_on_save": "on",
			"formatter": "prettier",
		},
		"JavaScript": {
			// "formatter": "language_server",
			"formatter": {
				"external": {
					"command": "prettier",
					"arguments": ["--stdin-filepath", "{buffer_path}"],
				},
			},
			"code_actions_on_format": {
				"source.fixAll.eslint": false,
			},
		},
		"Markdown": {
			"completions": { "words": "fallback" },
		},
		"HTML": {
			"formatter": "language_server",
			"format_on_save": "on",
		},
	},
	"git_panel": {
		"dock": "left",
		"sort_by_path": false,
		"tree_view": true,
	},
	"ssh_connections": [
		{
			"host": "ec2",
			"args": [],
			"projects": [
				{
					"paths": ["/home/ubuntu/Desktop/coding/python/./"],
				},
			],
		},
	],
	"lsp": {
		// "eslint": {
		// 	"settings": {
		// 		"codeActionOnSave": {
		// 			"rules": ["import/order"],
		// 		},
		// 		"options": {
		// 			"overrideConfigFile": "./.eslintrc.strict.json",
		// 		},
		// 	},
		// },
		"vscode-html-language-server": {
			"settings": {
				"html": {
					"format": {
						"wrapLineLength": 120,
						"indentInnerHtml": true,
						"preserveNewLines": true,
						"maxPreserveNewLines": 1,
						"indentHandlebars": false,
						"endWithNewline": true,
						"extraLiners": "head, body, /html",
						"wrapAttributes": "auto",
						// options: "auto", "force", "force-aligned", "force-expand-multiline"
					},
					"suggest": {
						"html5": true,
					},
				},
			},
		},
		"gopls": {
			"initialization_options": {
				"staticcheck": true,
				"gofumpt": true,
				"completeUnimported": true,
				"analyses": {
					"unusedparams": true,
					"shadow": true,
					"unusedwrite": true,
					"nilness": true,
					"useany": true,
					"nonewvars": true,
					"simplifyrange": true,
				},
				"codelenses": {
					"generate": true,
					"gc_details": true,
					"test": true,
					"tidy": true,
					"vendor": true,
					"regenerate_cgo": true,
					"upgrade_dependency": true,
					"run_govulncheck": true, // FIXED: The name is run_govulncheck, not vulncheck
				},
				"hints": {
					"assignVariableTypes": true,
					"compositeLiteralFields": true,
					"compositeLiteralTypes": true,
					"constantValues": true,
					"functionTypeParameters": true,
					"parameterNames": true,
					"rangeVariableTypes": true,
				},
				"vulncheck": "Imports", // Correct: This enables the background scanning
			},
		},
	},
	"snippet_sort_order": "bottom",
	"when_closing_with_no_tabs": "close_window",
	"remove_trailing_whitespace_on_save": false,
	"ensure_final_newline_on_save": false,
	"tab_bar": {
		"show_nav_history_buttons": false,
		"show_tab_bar_buttons": false,
		// "show": false,
	},
	"toolbar": {
		"breadcrumbs": false,
		"quick_actions": false,
	},
	"project_panel": {
		"dock": "left",
		"entry_spacing": "standard",
	},
	"tabs": { "file_icons": true },
	"git": {
		"inline_blame": { "enabled": false },
	},
	"current_line_highlight": "none",
	"prettier": {
		"singleQuote": true,
	},
	"terminal": {
		"dock": "bottom",
		"font_family": "JetBrainsMonoNL Nerd Font",
		"font_weight": 500.0,
	},
	"ui_font_family": "Iosevka Nerd Font Mono",
	"ui_font_weight": 700.0,
	"icon_theme": {
		"mode": "light",
		"light": "Material Icon Theme",
		"dark": "Material Icon Theme",
	},
	"context_servers": {
		"postgres-context-server": {
			"enabled": true,
			"remote": false,
			"settings": {
				"database_url": "postgresql://myuser:mypassword@localhost:5432/mydatabase",
			},
		},
	},
	"disable_ai": false,
	"agent_buffer_font_size": 14.0,
	"agent_ui_font_size": 18.0,
	"expand_excerpt_lines": 16,
	"agent": {
		"sidebar_side": "left",
		"dock": "right",
		"tool_permissions": {
			"default": "allow",
		},
		"default_profile": "write",
		"default_model": {
			"enable_thinking": true,
			"provider": "google",
			"model": "gemini-3.1-pro-preview",
		},
		"model_parameters": [],
	},
	"hard_tabs": true,
	"buffer_font_family": "Iosevka Nerd Font Mono",
	"buffer_font_weight": 600.0,
	"buffer_line_height": { "custom": 1.2 },
	"vim_mode": true,
	"relative_line_numbers": "enabled",
	"file_types": {
		"html": ["*.html"],
		"python": ["*.py"],
	},
	"base_keymap": "VSCode",
	"ui_font_size": 16.8,
	"buffer_font_size": 18.0,
	"theme": {
		"light": "Monokai Night Light",
		"mode": "dark",
		"dark": "Tokyo Night",
	},
	"experimental.theme_overrides": {
		"players": [
			{
				"selection": "#3D5564",
				"cursor": "#A8F2F1",
			},
		],
		"panel.background": "#090B17",
		"surface.background": "#090B17",
		"element.background": "#090B17", // Background of items in the tree
		"element.hover": "#161b2e", // Subtle highlight when hovering over files
		"element.active": "#3d59a1",

		"ghost_element.selected": "#212d3d", // Faded steel blue
		"ghost_element.hover": "#161e2a", // Very subtle lift
		"ghost_element.active": "#2d3c52", // Slightly brighter for the "click"

		"element.selected": "#2e3c64",

		"background.appearance": "opaque",
		"editor.background": "#090B17",
		"editor.gutter.background": "#090B17",
		"editor.hover_line_number": "#090B17",
		"toolbar.background": "#090B17",
		"status_bar.background": "#090B17",
		"title_bar.background": "#090B17",
		"pane.focused_border": "#3d59a1",
		"terminal.background": "#090B17",
		"terminal.foreground": "#a9b1d6",

		"tab_bar.background": "#05060e",
		"tab.active_background": "#161b2e",
		"tab.inactive_background": "#090B17",

		"version_control.added": "#00ff00ff",
		"version_control.deleted": "#ff0000ff",
	},

	// "experimental.theme_overrides": {
	//   "background": "#0C0C14BF",
	//   "background.appearance": "blurred",

	//   "panel.background": "#00000000",
	//   "editor.background": "#00000000",
	//   "terminal.background": "#00000066",
	//   "tab_bar.background": "#00000000",
	//   "status_bar.background": "#00000000",
	//   "toolbar.background": "#00000000",
	//   "editor.gutter.background": "#00000000",

	//   "tab.active_background": "#313244",
	//   "tab.inactive_background": "#00000000",

	//   "border": "#00000000",
	//   "border.variant": "#00000000",
	//   "border.focused": "#ffffff",

	//   "elevated_surface.background": "#1e1e2e",

	//   // 4. SOLID Hover Information (LSP / Errors)
	//   "hint.background": "#0C0C14",
	//   "error.background": "#0C0C14",
	//   "warning.background": "#0C0C14",
	//   "info.background": "#0C0C14",

	//   // 5. Title Bar (Solid)
	//   "title_bar.background": "#0C0C14",
	// },
	"gutter": {
		"min_line_number_digits": 0,
		"line_numbers": true,
		"runnables": false, // Removes the "play" button space (for tests/main)
		"folds": true, // Removes the arrow space for collapsing code
		"breakpoints": false, // Removes the red dot space for debugging
	},
	"diagnostics": {
		"inline": {
			"enabled": true,
		},
	},
}
